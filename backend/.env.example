# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/smart_restaurant?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# QR code base URL
# TEST ONLY for backend status check
QR_BASE_URL=http://192.168.2.9:5000/api

# For local development, use computer's local IPv4 address and the frontend port:
# Example: http://192.168.1.100:5174
QR_BASE_URL="http://host-device-ip:5173"

# For production/deployment, use deployed frontend URL:
# Example: https://restaurant-domain.com
QR_BASE_URL="https://restaurant-domain.com" 

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5174, http://host-device-ip:5173

# Stripe Configuration (Optional - for payment)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Momo Configuration (Vietnamese e-wallet)
# For testing: Use public sandbox credentials
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://host-device-ip:5173/customer/payment/result
MOMO_NOTIFY_URL=http://localhost:5000/api/payments/momo/callback

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (SMTP)
